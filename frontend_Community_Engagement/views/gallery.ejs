<%- include('layout', { body: `
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 flex items-center">
                    <i class="fas fa-images text-purple-600 mr-3"></i>
                    Photo Gallery
                </h1>
                <p class="mt-2 text-gray-600">Browse through our collection of memorable moments</p>
            </div>
            <div class="bg-purple-100 rounded-full p-3">
                <i class="fas fa-camera text-purple-600 text-xl"></i>
            </div>
        </div>
    </div>

    <!-- Albums Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        ${albums.length === 0 ? `
        <div class="col-span-full bg-white rounded-xl shadow-sm p-12 text-center">
            <div class="bg-gray-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-images text-gray-400 text-2xl"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No albums yet</h3>
            <p class="text-gray-500">Photo albums will appear here when they're added.</p>
        </div>
        ` : albums.map(album => `
        <div class="bg-white rounded-xl shadow-sm overflow-hidden card-hover">
            <div class="h-48 bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center">
                <i class="fas fa-images text-white text-4xl"></i>
            </div>
            
            <div class="p-6">
                <div class="flex items-center justify-between mb-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                        <i class="fas fa-photo-video mr-1"></i>
                        ${album.status || 'Active'}
                    </span>
                </div>
                
                <h3 class="text-xl font-semibold text-gray-900 mb-2">${album.album_name}</h3>
                
                <p class="text-gray-600 mb-3 leading-relaxed">${album.description || 'No description available'}</p>
                
                ${album.event ? `
                <div class="flex items-center text-sm text-gray-500 mb-4">
                    <i class="fas fa-calendar-event mr-2"></i>
                    <span>Event: ${album.event}</span>
                </div>
                ` : ''}
                
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500 flex items-center">
                        <i class="fas fa-calendar mr-1"></i>
                        ${album.creation_formatted}
                    </span>
                    
                    <a href="/album/${album.name}" 
                       class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                        <i class="fas fa-eye mr-2"></i>
                        View Images
                    </a>
                </div>
            </div>
        </div>
        `).join('')}
    </div>
</div>
` }) %>
