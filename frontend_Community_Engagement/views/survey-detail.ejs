<%- include('layout', { body: `
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 flex items-center">
                    <i class="fas fa-clipboard-list text-green-600 mr-3"></i>
                    Survey Questions
                </h1>
                <p class="mt-2 text-gray-600">Please answer all questions honestly</p>
            </div>
            <a href="/surveys" class="text-green-600 hover:text-green-700 flex items-center">
                <i class="fas fa-arrow-left mr-2"></i>
                Back to Surveys
            </a>
        </div>
    </div>

    <!-- Survey Form -->
    <div class="bg-white rounded-xl shadow-sm p-8">
        <form action="/submit-survey" method="POST" class="space-y-8">
            <input type="hidden" name="survey_name" value="${survey.name}">
            
            ${questions.length === 0 ? `
            <div class="text-center py-12">
                <div class="bg-gray-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-question text-gray-400 text-2xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No questions available</h3>
                <p class="text-gray-500">This survey doesn't have any questions yet.</p>
            </div>
            ` : questions.map((question, index) => `
            <div class="border border-gray-200 rounded-lg p-6">
                <div class="flex items-start space-x-3 mb-4">
                    <span class="bg-green-100 text-green-800 text-sm font-medium px-2.5 py-1 rounded-full">
                        ${index + 1}
                    </span>
                    <div class="flex-1">
                        <h3 class="text-lg font-medium text-gray-900 mb-2 break-words truncate">${question.question}</h3>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            <i class="fas ${question.type === 'Text' ? 'fa-align-left' : question.type === 'Rating' ? 'fa-star' : 'fa-list'} mr-1"></i>
                            ${question.type}
                        </span>
                    </div>
                </div>
                
                <div class="ml-10">
                    ${question.type === 'Text' ? `
                    <textarea name="answers[${index}][answer]" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                              rows="4" 
                              placeholder="Enter your response..."
                              required></textarea>
                    <input type="hidden" name="answers[${index}][question]" value="${question.name}">
                    <input type="hidden" name="answers[${index}][type]" value="${question.type}">
                    ` : question.type === 'Rating' ? `
                    <select name="answers[${index}][answer]" 
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                            required>
                        <option value="">Select a rating...</option>
                        <option value="1">1 - Poor</option>
                        <option value="2">2 - Fair</option>
                        <option value="3">3 - Good</option>
                        <option value="4">4 - Very Good</option>
                        <option value="5">5 - Excellent</option>
                    </select>
                    <input type="hidden" name="answers[${index}][question]" value="${question.name}">
                    <input type="hidden" name="answers[${index}][type]" value="${question.type}">
                    ` : `
                    <div class="space-y-2">
                        ${question.options ? question.options.map(option => `
                        <label class="flex items-center">
                            <input type="radio" name="answers[${index}][answer]" value="${option}" 
                                   class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300" required>
                            <span class="ml-2 text-gray-700">${option}</span>
                        </label>
                        `).join('') : `
                        <p class="text-gray-500 italic">No options available for this question</p>
                        `}
                    </div>
                    <input type="hidden" name="answers[${index}][question]" value="${question.name}">
                    <input type="hidden" name="answers[${index}][type]" value="${question.type}">
                    `}
                </div>
            </div>
            `).join('')}
            
            ${questions.length > 0 ? `
            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
                <a href="/surveys" 
                   class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition-colors">
                    Cancel
                </a>
                <button type="submit" 
                        class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-colors flex items-center">
                    <i class="fas fa-paper-plane mr-2"></i>
                    Submit Survey
                </button>
            </div>
            ` : ''}
        </form>
    </div>
</div>
` }) %>
