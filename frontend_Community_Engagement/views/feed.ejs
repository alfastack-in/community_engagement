<%- include('layout', { body: `
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 flex items-center">
                    <i class="fas fa-comments text-orange-600 mr-3"></i>
                    Engagement Feed
                </h1>
                <p class="mt-2 text-gray-600">Join the conversation and share your thoughts</p>
            </div>
            <div class="bg-orange-100 rounded-full p-3">
                <i class="fas fa-users text-orange-600 text-xl"></i>
            </div>
        </div>
    </div>

    <!-- Post Comment Form -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
        <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
            <i class="fas fa-plus-circle text-orange-600 mr-2"></i>
            Share Your Thoughts
        </h3>
        
        <form action="/post-comment" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="document_type" class="block text-sm font-medium text-gray-700 mb-1">
                        Content Type
                    </label>
                    <select name="document_type" id="document_type" required
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500">
                        <option value="">Select type...</option>
                        <option value="Community Announcement">Announcement</option>
                        <option value="Community Survey">Survey</option>
                        <option value="Gallery Album">Gallery</option>
                        <option value="Event">Event</option>
                    </select>
                </div>
                
                <div>
                    <label for="parent_document" class="block text-sm font-medium text-gray-700 mb-1">
                        Document
                    </label>
                    <select name="parent_document" id="parent_document" required
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500">
                        <option value="">Select document...</option>
                    </select>
                </div>
            </div>
            
            <div>
                <label for="comment_text" class="block text-sm font-medium text-gray-700 mb-1">
                    Your Comment
                </label>
                <textarea name="comment_text" id="comment_text" rows="4" required
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
                          placeholder="Share your thoughts, feedback, or questions..."></textarea>
            </div>
            
            <div class="flex justify-end">
                <button type="submit" 
                        class="bg-orange-600 hover:bg-orange-700 text-white px-6 py-2 rounded-lg font-medium transition-colors flex items-center">
                    <i class="fas fa-paper-plane mr-2"></i>
                    Post Comment
                </button>
            </div>
        </form>
    </div>

    <!-- Comments Feed -->
    <div class="space-y-6">
        ${comments.length === 0 ? `
        <div class="bg-white rounded-xl shadow-sm p-12 text-center">
            <div class="bg-gray-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-comments text-gray-400 text-2xl"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No comments yet</h3>
            <p class="text-gray-500">Be the first to start a conversation!</p>
        </div>
        ` : comments.map(comment => `
        <div class="bg-white rounded-xl shadow-sm p-6 card-hover">
            <div class="flex items-start space-x-4">
                <div class="bg-orange-100 rounded-full p-3 flex-shrink-0">
                    <i class="fas fa-user text-orange-600"></i>
                </div>
                
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center space-x-2">
                            <h4 class="text-sm font-semibold text-gray-900">${comment.employee}</h4>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                <i class="fas ${comment.document_type === 'Community Announcement' ? 'fa-bullhorn' : comment.document_type === 'Community Survey' ? 'fa-poll' : comment.document_type === 'Gallery Album' ? 'fa-images' : 'fa-calendar'} mr-1"></i>
                                ${comment.document_type}
                            </span>
                        </div>
                        <span class="text-sm text-gray-500">${comment.creation_formatted}</span>
                    </div>
                    
                    <p class="text-gray-700 leading-relaxed mb-3 break-words">${comment.comment_text}</p>
                    
                    <div class="flex items-center text-sm text-gray-500 break-all">
                        <i class="fas fa-link mr-1"></i>
                        <span>Related to: ${comment.parent_document}</span>
                    </div>
                </div>
            </div>
        </div>
        `).join('')}
    </div>
</div>

<script>
// Dynamic parent document loading
var docTypeSelect = document.getElementById('document_type');
var parentDocSelect = document.getElementById('parent_document');

async function loadParentDocuments(doctype) {
    parentDocSelect.innerHTML = '<option value="">Loading...</option>';
    try {
        var res = await fetch('/get-documents?doctype=' + encodeURIComponent(doctype));
        var data = await res.json();
        if (data.documents && data.documents.length > 0) {
            var options = '<option value="">Select document...</option>';
            options += data.documents.map(function(doc) {
                return '<option value="' + doc.name + '">' + doc.title + '</option>';
            }).join('');
            parentDocSelect.innerHTML = options;
        } else {
            parentDocSelect.innerHTML = '<option value="">No documents found</option>';
        }
    } catch (err) {
        parentDocSelect.innerHTML = '<option value="">Failed to load</option>';
    }
}

docTypeSelect.addEventListener('change', function() {
    if (this.value) {
        loadParentDocuments(this.value);
    } else {
        parentDocSelect.innerHTML = '<option value="">Select document...</option>';
    }
});
</script>
` }) %>
